# NIA Environment Configuration Template
# Copy this file to .env and configure values locally. Never commit secrets.

# Backend (FastAPI) Configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:8081","http://localhost:3000","*"]
LOG_LEVEL=INFO

# Security / Verification Gate
SAFE_ACTION_AUTO_APPROVE=false
DEBUG_SIMULATION_MODE=true

# Phone / Frontend Client
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_AI_RUNTIME=phone_local
EXPO_PUBLIC_ENABLE_SIMULATION_ADAPTERS=true
